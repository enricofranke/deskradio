# ============================================================================
#  Deskradio – configuration
#  Copy to .env and fill in. Never commit .env.
# ============================================================================

# Required. Developer Portal → your app → Bot → Reset Token.
# Shortcut: copy the token, then run `npm run token` (writes it here without printing it).
RADIO_BOT_TOKEN=

# Server and voice channel (Discord: Settings → Advanced → Developer Mode,
# then right-click → Copy ID). Without a server ID the bot uses the only server
# it is on, but only if that server has at most 10 members. Without a channel
# ID it takes the first voice channel.
RADIO_GUILD_ID=
RADIO_CHANNEL_ID=

# Roles that may switch stations and change the volume directly (comma-separated).
# The server owner and everyone with Administrator can always do that.
RADIO_TEAM_ROLES=

# Name shown in the radio panel.
RADIO_NAME=Deskradio

# Language of the panel and the bot's replies: en or de.
# Slash commands follow each user's Discord language automatically.
RADIO_LANGUAGE=en

# Song requests from YouTube and SoundCloud via yt-dlp: on or off.
RADIO_WISHES=on

# Optional: text channel for error reports, e.g. when the voice connection fails.
RADIO_ERROR_CHANNEL_ID=

# Station, volume and on/off survive restarts here.
RADIO_STATE_FILE=data/state.json

# yt-dlp downloads requests here (emptied on every start).
RADIO_CACHE_DIR=data/cache
RADIO_YTDLP=yt-dlp

# Health endpoint for container probes (/health). 0 turns it off.
HEALTH_PORT=0

NODE_ENV=development
LOG_LEVEL=info
